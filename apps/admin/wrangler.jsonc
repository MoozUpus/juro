{
  "$schema": "../platform/node_modules/wrangler/config-schema.json",
  "name": "juro-admin-development",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "workers_dev": false,
  "vars": {
    "APP_ENV": "development",
    "PLATFORM_ORIGIN": "http://localhost:3000"
  },
  "services": [
    {
      "binding": "PLATFORM_ADMIN_API",
      "service": "juro-platform-development"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "env": {
    "staging": {
      "name": "juro-admin-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "admin.staging.juro.uz",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "PLATFORM_ORIGIN": "https://staging.app.juro.uz",
        "LEGAL_CORPUS_QUEUE_PROCESSING_ENABLED": "true"
      },
      "services": [
        {
          "binding": "PLATFORM_ADMIN_API",
          "service": "juro-platform-staging"
        }
      ]
    },
    "production": {
      "name": "juro-admin",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "PLATFORM_ORIGIN": "https://app.juro.uz"
      },
      "services": [
        {
          "binding": "PLATFORM_ADMIN_API",
          "service": "juro"
        }
      ]
    }
  }
}
