{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-legal-history-custom-20260906",
  "main": "./worker/legal-custom-history-build-worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 120000, "subrequests": 100000 },
  "vars": {
    "APP_ENV": "staging",
    "AI_GATEWAY_ID": "juro-ai-search-staging",
    "DOCUMENT_EMBEDDINGS_ENABLED": "true",
    "ACCEPTED_INPUT_MANIFEST_KEY": "accepted-inputs/history/a7e317302c0221e200f73b65a11506e781eae3e782e939d31b96554a19bae90f/manifest-3b981bd4cb59b7b812c8690ae17418a11fb4fec772b72d79a09244a7fdb606ac.json",
    "ACCEPTED_INPUT_MANIFEST_SHA256": "3b981bd4cb59b7b812c8690ae17418a11fb4fec772b72d79a09244a7fdb606ac",
    "OPENAI_REQUESTS_PER_MINUTE": "4000",
    "OPENAI_TOKENS_PER_MINUTE": "900000",
    "AUTHORIZED_PROVIDER_TOKENS": "15042720",
    "AUTHORIZED_EMBEDDING_RECONCILIATION_SHA256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "CUSTOM_SEARCH_CAPABILITY": "history",
    "CUSTOM_SEARCH_RELEASE_ID": "release:staging:history:custom-v1:2026-09-06",
    "CUSTOM_SEARCH_INSTANCE_ID": "custom-history-staging-v1",
    "CUSTOM_SEARCH_SHARD_ID": "history-base-v1",
    "CUSTOM_RUNTIME_DESCRIPTOR_KEY": "search-releases/release:staging:history:custom-v1:2026-09-06/runtime/descriptor-45104e9c45a52a24b11e5e43b86e0ac007da1dd71577aa4ae68ccfa7160806bb.json",
    "CUSTOM_RUNTIME_DESCRIPTOR_SHA256": "45104e9c45a52a24b11e5e43b86e0ac007da1dd71577aa4ae68ccfa7160806bb"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "SOURCE_DB",
      "database_name": "juro-staging",
      "database_id": "bb716a96-b2fb-4823-90d6-6c228fed181a"
    },
    {
      "binding": "CATALOG_DB",
      "database_name": "juro-legal-catalog-staging-green3-20260905",
      "database_id": "10c71209-7cf6-47c3-a74e-9697e32d7c29"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REUSABLE_ARTIFACTS",
      "bucket_name": "juro-legal-custom-prototype-20260903"
    },
    {
      "binding": "EVIDENCE",
      "bucket_name": "juro-legal-evidence-staging-green2-20260831"
    },
    {
      "binding": "ARTIFACTS",
      "bucket_name": "juro-legal-current-custom-20260903"
    }
  ],
  "vectorize": [
    {
      "binding": "DENSE",
      "index_name": "juro-legal-history-custom-20260906"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BUILD_QUEUE",
        "queue": "juro-legal-history-custom-20260906"
      }
    ],
    "consumers": [
      {
        "queue": "juro-legal-history-custom-20260906",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "juro-legal-history-custom-20260906-dlq",
        "max_concurrency": 16
      }
    ]
  },
  "workflows": [
    {
      "binding": "BUILD_WORKFLOW",
      "name": "juro-legal-history-custom-build-20260906",
      "class_name": "CustomHistoryBuildWorkflow"
    },
    {
      "binding": "REDUCE_WORKFLOW",
      "name": "juro-legal-history-custom-reduce-20260906",
      "class_name": "CustomHistoryReduceWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "CustomHistoryBuildCoordinator"
      },
      {
        "name": "REDUCER",
        "class_name": "CustomHistoryBm25ReducerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CustomHistoryBuildCoordinator", "CustomHistoryBm25ReducerContainer"]
    }
  ],
  "containers": [
    {
      "name": "juro-legal-history-custom-reducer-20260906",
      "class_name": "CustomHistoryBm25ReducerContainer",
      "image": "docker.io/library/node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5",
      "max_instances": 1,
      "instance_type": "standard-4",
      "constraints": { "regions": ["APAC"] },
      "ssh": { "enabled": false },
      "rollout_step_percentage": 100
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  }
}
