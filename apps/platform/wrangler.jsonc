{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-platform-development",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "development",
    "ASYNC_RUNTIME_ENABLED": "false",
    "CRON_ENABLED": "false",
    "ACCOUNT_DELETION_PURGE_ENABLED": "false",
    "STAGING_SYNTHETIC_PROBES_ENABLED": "false",
    "LEGAL_ADVICE_INGESTION_ENABLED": "false",
    "LEGAL_SOURCE_STAFF_API_ENABLED": "false",
    "IDENTITY_PROTECTION_MODE": "legacy",
    "JOB_SCHEMA_VERSION": "1",
    "EMAIL_FROM": "JURO <no-reply@juro.uz>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juro-development",
      "database_id": "d07670cf-f7bf-460c-a668-101671d4c330",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "juro-development-files"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "juro-development-backups"
    },
    {
      "binding": "QUARANTINE_BUCKET",
      "bucket_name": "juro-development-quarantine"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DOCUMENT_ANALYSIS_QUEUE",
        "queue": "development-document-analysis"
      },
      {
        "binding": "OCR_PROCESSING_QUEUE",
        "queue": "development-ocr-processing"
      },
      {
        "binding": "DOCUMENT_EXPORT_QUEUE",
        "queue": "development-document-export"
      },
      {
        "binding": "EMAIL_NOTIFICATIONS_QUEUE",
        "queue": "development-email-notifications"
      },
      {
        "binding": "LEGAL_SOURCES_SYNC_QUEUE",
        "queue": "development-legal-sources-sync"
      },
      {
        "binding": "DATA_RETENTION_CLEANUP_QUEUE",
        "queue": "development-data-retention-cleanup"
      },
      {
        "binding": "NOTIFICATIONS_QUEUE",
        "queue": "development-notifications"
      }
    ],
    "consumers": []
  },
  "vectorize": [
    {
      "binding": "LEX_UZ_INDEX",
      "index_name": "development-lex-uz"
    },
    {
      "binding": "ADVICE_UZ_INDEX",
      "index_name": "development-advice-uz"
    },
    {
      "binding": "INTERNAL_LEGAL_MATERIALS_INDEX",
      "index_name": "development-internal-legal-materials"
    },
    {
      "binding": "USER_DOCUMENTS_INDEX",
      "index_name": "development-user-documents"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PLATFORM_ANALYTICS",
      "dataset": "juro-platform-development"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "env": {
    "staging": {
      "name": "juro-platform-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "assets": {
        "binding": "ASSETS"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "vars": {
        "APP_ENV": "staging",
        "ASYNC_RUNTIME_ENABLED": "true",
        "CRON_ENABLED": "true",
        "ACCOUNT_DELETION_PURGE_ENABLED": "true",
        "STAGING_SYNTHETIC_PROBES_ENABLED": "false",
        "LEGAL_ADVICE_INGESTION_ENABLED": "false",
        "LEGAL_SOURCE_STAFF_API_ENABLED": "false",
        "IDENTITY_PROTECTION_MODE": "legacy",
        "JOB_SCHEMA_VERSION": "1",
        "EMAIL_FROM": "JURO <no-reply@juro.uz>",
        "OPENAI_CHAT_MODEL": "gpt-5.6-sol",
        "OPENAI_DEEP_MODEL": "gpt-5.6-sol",
        "ANTHROPIC_FALLBACK_MODEL": "claude-sonnet-4-6"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "juro-staging",
          "database_id": "bb716a96-b2fb-4823-90d6-6c228fed181a",
          "migrations_dir": "./drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "juro-staging-files"
        },
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "juro-staging-backups"
        },
        {
          "binding": "QUARANTINE_BUCKET",
          "bucket_name": "juro-staging-quarantine"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "DOCUMENT_ANALYSIS_QUEUE",
            "queue": "staging-document-analysis"
          },
          {
            "binding": "OCR_PROCESSING_QUEUE",
            "queue": "staging-ocr-processing"
          },
          {
            "binding": "DOCUMENT_EXPORT_QUEUE",
            "queue": "staging-document-export"
          },
          {
            "binding": "EMAIL_NOTIFICATIONS_QUEUE",
            "queue": "staging-email-notifications"
          },
          {
            "binding": "LEGAL_SOURCES_SYNC_QUEUE",
            "queue": "staging-legal-sources-sync"
          },
          {
            "binding": "DATA_RETENTION_CLEANUP_QUEUE",
            "queue": "staging-data-retention-cleanup"
          },
          {
            "binding": "NOTIFICATIONS_QUEUE",
            "queue": "staging-notifications"
          }
        ],
        "consumers": [
          {
            "queue": "staging-legal-sources-sync",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "staging-legal-sources-sync-dlq",
            "max_concurrency": 1,
            "retry_delay": 30
          },
          {
            "queue": "staging-email-notifications",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "staging-email-notifications-dlq",
            "max_concurrency": 2,
            "retry_delay": 30
          },
          {
            "queue": "staging-data-retention-cleanup",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "staging-data-retention-cleanup-dlq",
            "max_concurrency": 1,
            "retry_delay": 30
          }
        ]
      },
      "vectorize": [
        {
          "binding": "LEX_UZ_INDEX",
          "index_name": "staging-lex-uz"
        },
        {
          "binding": "ADVICE_UZ_INDEX",
          "index_name": "staging-advice-uz"
        },
        {
          "binding": "INTERNAL_LEGAL_MATERIALS_INDEX",
          "index_name": "staging-internal-legal-materials"
        },
        {
          "binding": "USER_DOCUMENTS_INDEX",
          "index_name": "staging-user-documents"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "PLATFORM_ANALYTICS",
          "dataset": "juro-platform-staging"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    },
    "production": {
      "name": "juro-platform-production",
      "assets": {
        "binding": "ASSETS"
      },
      "vars": {
        "APP_ENV": "production",
        "ASYNC_RUNTIME_ENABLED": "false",
        "CRON_ENABLED": "false",
        "ACCOUNT_DELETION_PURGE_ENABLED": "false",
        "STAGING_SYNTHETIC_PROBES_ENABLED": "false",
        "LEGAL_ADVICE_INGESTION_ENABLED": "false",
        "LEGAL_SOURCE_STAFF_API_ENABLED": "false",
        "IDENTITY_PROTECTION_MODE": "legacy",
        "JOB_SCHEMA_VERSION": "1",
        "EMAIL_FROM": "JURO <no-reply@juro.uz>"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "juro-production",
          "migrations_dir": "./drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "juro-private-documents"
        },
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "juro-production-backups"
        },
        {
          "binding": "QUARANTINE_BUCKET",
          "bucket_name": "juro-production-quarantine"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "DOCUMENT_ANALYSIS_QUEUE",
            "queue": "production-document-analysis"
          },
          {
            "binding": "OCR_PROCESSING_QUEUE",
            "queue": "production-ocr-processing"
          },
          {
            "binding": "DOCUMENT_EXPORT_QUEUE",
            "queue": "production-document-export"
          },
          {
            "binding": "EMAIL_NOTIFICATIONS_QUEUE",
            "queue": "production-email-notifications"
          },
          {
            "binding": "LEGAL_SOURCES_SYNC_QUEUE",
            "queue": "production-legal-sources-sync"
          },
          {
            "binding": "DATA_RETENTION_CLEANUP_QUEUE",
            "queue": "production-data-retention-cleanup"
          },
          {
            "binding": "NOTIFICATIONS_QUEUE",
            "queue": "production-notifications"
          }
        ],
        "consumers": []
      },
      "vectorize": [
        {
          "binding": "LEX_UZ_INDEX",
          "index_name": "production-lex-uz"
        },
        {
          "binding": "ADVICE_UZ_INDEX",
          "index_name": "production-advice-uz"
        },
        {
          "binding": "INTERNAL_LEGAL_MATERIALS_INDEX",
          "index_name": "production-internal-legal-materials"
        },
        {
          "binding": "USER_DOCUMENTS_INDEX",
          "index_name": "production-user-documents"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "PLATFORM_ANALYTICS",
          "dataset": "juro-platform-production"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
