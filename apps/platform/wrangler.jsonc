{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juro",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "keep_vars": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juro-production",
      "database_id": "4cce509b-0e02-4ca9-a3ba-a5ce1327aeda"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "juro-private-documents"
    }
  ]
}
