{
  "name": "juro-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "JURO_AGENT_PREVIEW_COMPATIBILITY_DATE=2026-05-22 ALLOW_PLATFORM_AUTH_HEADERS=true WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:staging": "CLOUDFLARE_ENV=staging bash scripts/build-verified.sh",
    "build:production": "CLOUDFLARE_ENV=production bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-loader ./scripts/cloudflare-workers-loader.mjs --test tests/rendered-html.test.mjs && node --import tsx --test tests/document-builder.test.ts tests/document-comparison.test.ts tests/document-registry.test.ts tests/document-access.test.ts tests/auth-otp.test.ts tests/auth-sessions.test.ts tests/auth-keyring.test.ts tests/identity-protection.test.ts tests/identity-evidence.test.ts tests/challenge-evidence.test.ts tests/auth-mfa-crypto.test.ts tests/auth-mfa.test.ts tests/account-deletion.test.ts tests/email-change.test.ts tests/legal-source-trust.test.ts tests/policy-acceptance.test.ts tests/platform-core.test.ts && npm run test:cloudflare",
    "smoke:document-builder": "node --import tsx scripts/smoke-document-builder.ts",
    "smoke:document-comparison": "node --import tsx scripts/smoke-document-comparison.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "cf:types": "bash scripts/sites-env.sh -- wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "cf:types:check": "bash scripts/sites-env.sh -- wrangler types worker-configuration.d.ts --check --config wrangler.jsonc",
    "validate:cloudflare:matrix": "bash scripts/sites-env.sh -- bash scripts/validate-cloudflare-build-matrix.sh",
    "test:cloudflare": "node --import tsx --test tests/cloudflare-config.test.ts tests/migration-safety.test.ts tests/worker-jobs.test.ts",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern 'dist/**' --ignore-pattern '.next/**' --ignore-pattern '.wrangler/**' --ignore-pattern '.sites-runtime/**' --ignore-pattern 'outputs/**' --ignore-pattern worker-configuration.d.ts",
    "type-check": "bash scripts/sites-env.sh -- tsc --noEmit",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-virtuoso": "4.18.11",
    "unpdf": "1.8.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pizzip": "^3.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module",
  "displayName": "JURO — Личный кабинет"
}
