{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-legal-history-custom-production-20260908",
  "main": "./worker/legal-custom-search-worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 120000, "subrequests": 100000 },
  "vars": {
    "APP_ENV": "production",
    "AI_GATEWAY_ID": "juro-ai-search-production",
    "CUSTOM_SEARCH_CAPABILITY": "history",
    "CUSTOM_SEARCH_RELEASE_ID": "release:production:history:custom-v1:2026-09-08",
    "CUSTOM_SEARCH_PHYSICAL_RELEASE_ID": "release:staging:history:custom-v1:2026-09-06",
    "CUSTOM_SEARCH_INSTANCE_ID": "custom-history-production-v1",
    "CUSTOM_SEARCH_SHARD_ID": "history-base-v1",
    "CUSTOM_RUNTIME_DESCRIPTOR_KEY": "search-releases/release:staging:history:custom-v1:2026-09-06/runtime/descriptor-45104e9c45a52a24b11e5e43b86e0ac007da1dd71577aa4ae68ccfa7160806bb.json",
    "CUSTOM_RUNTIME_DESCRIPTOR_SHA256": "45104e9c45a52a24b11e5e43b86e0ac007da1dd71577aa4ae68ccfa7160806bb"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "juro-legal-catalog-production-green-20260908",
      "database_id": "4381cd22-4b1f-461c-9654-bc29789039c1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "juro-legal-current-custom-20260903"
    }
  ],
  "vectorize": [
    {
      "binding": "DENSE",
      "index_name": "juro-legal-history-custom-20260906"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  }
}
