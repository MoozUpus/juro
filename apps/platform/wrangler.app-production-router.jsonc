{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-app-production-router",
  "main": "./worker/app-production-router.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // `app.juro.uz` is an owner-designated staging hostname as of 2026-08-09.
  // Keep this legacy router detached so a manual deploy cannot reclaim it for
  // production. Production hostname activation needs separate owner approval.
  "routes": [],
  "services": [
    {
      "binding": "PLATFORM",
      "service": "juro",
      "environment": "production"
    }
  ]
}
