{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-app-production-router",
  "main": "./worker/app-production-router.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // `app.juro.uz` is the production hostname. Its custom-domain attachment is
  // managed out of band; keeping routes empty prevents this legacy router from
  // destructively recreating the domain while its service binding continues to
  // target the production environment of the canonical `juro` Worker.
  "routes": [],
  "services": [
    {
      "binding": "PLATFORM",
      "service": "juro",
      "environment": "production"
    }
  ]
}
