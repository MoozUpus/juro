{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-legal-corpus-development",
  "main": "./worker/legal-corpus-worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 120000, "subrequests": 100000 },
  "vars": {
    "APP_ENV": "development",
    "LEGAL_CORPUS_LEGACY_WRITES_ENABLED": "false",
    "LEGAL_CORPUS_SHADOW_MODE": "false",
    "LEGAL_EVIDENCE_BUCKET_NAME": "juro-legal-evidence-development",
    "LEGAL_AI_GATEWAY_ID": "juro-ai-search-development",
    "LEGAL_AI_PROVIDER_PROJECT_ID": "juro-openai-development"
  },
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "LEGAL_DB",
      "database_name": "juro-legal-catalog-development",
      "migrations_dir": "./legal-drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LEGAL_EVIDENCE_BUCKET",
      "bucket_name": "juro-legal-evidence-development"
    }
  ],
  "services": [
    {
      "binding": "LEGAL_CORPUS_REASONING_SERVICE",
      "service": "juro-platform-development"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "env": {
    "staging": {
      "name": "juro-legal-corpus-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "LEGAL_CORPUS_LEGACY_WRITES_ENABLED": "false",
        "LEGAL_CORPUS_SHADOW_MODE": "true",
        "LEGAL_EVIDENCE_BUCKET_NAME": "juro-legal-evidence-staging-green2-20260831",
        "LEGAL_AI_GATEWAY_ID": "juro-ai-search-staging",
        "LEGAL_AI_PROVIDER_PROJECT_ID": "juro-openai-staging"
      },
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "LEGAL_DB",
          "database_name": "juro-legal-catalog-staging-green3-20260905",
          "database_id": "10c71209-7cf6-47c3-a74e-9697e32d7c29",
          "migrations_dir": "./legal-drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "LEGAL_EVIDENCE_BUCKET",
          "bucket_name": "juro-legal-evidence-staging-green2-20260831"
        },
        {
          "binding": "LEGAL_CUSTOM_ARTIFACT_BUCKET",
          "bucket_name": "juro-legal-current-custom-20260903"
        }
      ],
      "services": [
        {
          "binding": "LEGAL_CORPUS_REASONING_SERVICE",
          "service": "juro-platform-staging"
        },
        {
          "binding": "LEGAL_CUSTOM_SEARCH_SERVICE",
          "service": "juro-legal-current-custom-pair-20260906"
        },
        {
          "binding": "LEGAL_CUSTOM_HISTORY_SEARCH_SERVICE",
          "service": "juro-legal-history-custom-20260906"
        }
      ]
    },
    "production": {
      "name": "juro-legal-corpus",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "LEGAL_CORPUS_LEGACY_WRITES_ENABLED": "false",
        "LEGAL_CORPUS_SHADOW_MODE": "false",
        "LEGAL_EVIDENCE_BUCKET_NAME": "juro-legal-evidence-production-20260908",
        "LEGAL_AI_GATEWAY_ID": "juro-ai-search-production",
        "LEGAL_AI_PROVIDER_PROJECT_ID": "juro-openai-production"
      },
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "LEGAL_DB",
          "database_name": "juro-legal-catalog-production-green-20260908",
          "database_id": "4381cd22-4b1f-461c-9654-bc29789039c1",
          "migrations_dir": "./legal-drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "LEGAL_EVIDENCE_BUCKET",
          "bucket_name": "juro-legal-evidence-production-20260908"
        },
        {
          "binding": "LEGAL_HISTORY_EVIDENCE_BUCKET",
          "bucket_name": "juro-legal-evidence-staging-green2-20260831"
        },
        {
          "binding": "LEGAL_CUSTOM_ARTIFACT_BUCKET",
          "bucket_name": "juro-legal-current-custom-production-20260908"
        }
      ],
      "services": [
        {
          "binding": "LEGAL_CORPUS_REASONING_SERVICE",
          "service": "juro"
        },
        {
          "binding": "LEGAL_CUSTOM_SEARCH_SERVICE",
          "service": "juro-legal-current-search-production-20260909"
        },
        {
          "binding": "LEGAL_CUSTOM_HISTORY_SEARCH_SERVICE",
          "service": "juro-legal-history-custom-production-20260908"
        }
      ]
    }
  }
}
