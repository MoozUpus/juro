{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-legal-corpus-development",
  "main": "./worker/legal-corpus-worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "development",
    "LEGAL_CORPUS_ENABLED": "false",
    "LEGAL_CORPUS_AUTO_INGEST_ENABLED": "false",
    "LEGAL_CORPUS_LIVE_LEXUZ_ENABLED": "false",
    "LEGAL_CORPUS_MULTILINGUAL_ENABLED": "false",
    "LEGAL_CORPUS_OWNER_UPLOAD_AUTO_TRUST": "false",
    "LEGAL_CORPUS_USER_UPLOAD_AUTO_TRUST": "false",
    "LEGAL_CORPUS_HISTORICAL_ENABLED": "false",
    "LEGAL_CORPUS_SHADOW_MODE": "false"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "5 19 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juro-development",
      "database_id": "d07670cf-f7bf-460c-a668-101671d4c330",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "juro-development-files"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "env": {
    "staging": {
      "name": "juro-legal-corpus-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "LEGAL_CORPUS_ENABLED": "false",
        "LEGAL_CORPUS_AUTO_INGEST_ENABLED": "false",
        "LEGAL_CORPUS_LIVE_LEXUZ_ENABLED": "false",
        "LEGAL_CORPUS_MULTILINGUAL_ENABLED": "false",
        "LEGAL_CORPUS_OWNER_UPLOAD_AUTO_TRUST": "false",
        "LEGAL_CORPUS_USER_UPLOAD_AUTO_TRUST": "false",
        "LEGAL_CORPUS_HISTORICAL_ENABLED": "false",
        "LEGAL_CORPUS_SHADOW_MODE": "false"
      },
      "triggers": {
        "crons": ["*/5 * * * *", "5 19 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "juro-staging",
          "database_id": "bb716a96-b2fb-4823-90d6-6c228fed181a",
          "migrations_dir": "./drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "juro-staging-files"
        }
      ]
    },
    "production": {
      "name": "juro-legal-corpus",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "LEGAL_CORPUS_ENABLED": "false",
        "LEGAL_CORPUS_AUTO_INGEST_ENABLED": "false",
        "LEGAL_CORPUS_LIVE_LEXUZ_ENABLED": "false",
        "LEGAL_CORPUS_MULTILINGUAL_ENABLED": "false",
        "LEGAL_CORPUS_OWNER_UPLOAD_AUTO_TRUST": "false",
        "LEGAL_CORPUS_USER_UPLOAD_AUTO_TRUST": "false",
        "LEGAL_CORPUS_HISTORICAL_ENABLED": "false",
        "LEGAL_CORPUS_SHADOW_MODE": "false"
      },
      "triggers": {
        "crons": ["*/5 * * * *", "5 19 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "juro-production",
          "database_id": "4cce509b-0e02-4ca9-a3ba-a5ce1327aeda",
          "migrations_dir": "./drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "juro-private-documents"
        }
      ]
    }
  }
}
