{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-legal-current-custom-20260903",
  "main": "./worker/legal-custom-current-build-worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "staging",
    "AI_GATEWAY_ID": "juro-ai-search-staging",
    "DOCUMENT_EMBEDDINGS_ENABLED": "true",
    "ACCEPTED_INPUT_MANIFEST_KEY": "accepted-inputs/current/a7e317302c0221e200f73b65a11506e781eae3e782e939d31b96554a19bae90f/manifest-d73c6ec663ba07e357eaf5a64e7b01ec6f4a0830535f5004c99132f03081a66a.json",
    "ACCEPTED_INPUT_MANIFEST_SHA256": "d73c6ec663ba07e357eaf5a64e7b01ec6f4a0830535f5004c99132f03081a66a",
    "OPENAI_REQUESTS_PER_MINUTE": "4000",
    "OPENAI_TOKENS_PER_MINUTE": "900000",
    "AUTHORIZED_PROVIDER_TOKENS": "94508602"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "SOURCE_DB",
      "database_name": "juro-staging",
      "database_id": "bb716a96-b2fb-4823-90d6-6c228fed181a"
    },
    {
      "binding": "LEGAL_DB",
      "database_name": "juro-legal-catalog-staging-green2-20260831",
      "database_id": "23863e4f-6a11-4c25-888a-63abf695248b",
      "migrations_dir": "./legal-drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REUSABLE_ARTIFACTS",
      "bucket_name": "juro-legal-custom-prototype-20260903"
    },
    {
      "binding": "EVIDENCE",
      "bucket_name": "juro-legal-evidence-staging-green2-20260831"
    },
    {
      "binding": "ARTIFACTS",
      "bucket_name": "juro-legal-current-custom-20260903"
    }
  ],
  "vectorize": [
    {
      "binding": "DENSE",
      "index_name": "juro-legal-current-custom-20260903"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BUILD_QUEUE",
        "queue": "juro-legal-current-custom-20260905"
      }
    ],
    "consumers": [
      {
        "queue": "juro-legal-current-custom-20260905",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "juro-legal-current-custom-20260905-dlq",
        "max_concurrency": 32
      }
    ]
  },
  "workflows": [
    {
      "binding": "BUILD_WORKFLOW",
      "name": "juro-legal-current-custom-build-20260903",
      "class_name": "CustomCurrentBuildWorkflow"
    },
    {
      "binding": "REDUCE_WORKFLOW",
      "name": "juro-legal-current-custom-reduce-20260903",
      "class_name": "CustomCurrentReduceWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "CustomCurrentBuildCoordinator"
      },
      {
        "name": "REDUCER",
        "class_name": "CustomCurrentBm25ReducerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CustomCurrentBuildCoordinator", "CustomCurrentBm25ReducerContainer"]
    }
  ],
  "containers": [
    {
      "name": "juro-legal-current-custom-reducer-20260903",
      "class_name": "CustomCurrentBm25ReducerContainer",
      "image": "docker.io/library/node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5",
      "max_instances": 1,
      "instance_type": "standard-4",
      "constraints": { "regions": ["APAC"] },
      "ssh": { "enabled": false },
      "rollout_step_percentage": 100
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
