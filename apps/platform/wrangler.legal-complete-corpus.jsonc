{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "e22babd36b65c99b69adf3de50df5227",
  "name": "juro-legal-complete-corpus-20260904",
  "main": "./worker/legal-complete-corpus-materialization-worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "staging",
    "CLOUDFLARE_ACCOUNT_ID": "e22babd36b65c99b69adf3de50df5227"
  },
  "d1_databases": [
    {
      "binding": "SOURCE_DB",
      "database_name": "juro-staging",
      "database_id": "bb716a96-b2fb-4823-90d6-6c228fed181a"
    },
    {
      "binding": "LEGAL_DB",
      "database_name": "juro-legal-catalog-staging-green2-20260831",
      "database_id": "23863e4f-6a11-4c25-888a-63abf695248b",
      "migrations_dir": "./legal-drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "SOURCE_EVIDENCE", "bucket_name": "juro-staging-files" },
    { "binding": "EVIDENCE", "bucket_name": "juro-legal-evidence-staging-green2-20260831" }
  ],
  "queues": {
    "producers": [
      { "binding": "MATERIALIZATION_QUEUE", "queue": "juro-legal-complete-corpus-20260904" }
    ],
    "consumers": [
      {
        "queue": "juro-legal-complete-corpus-20260904",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 12,
        "retry_delay": 30,
        "dead_letter_queue": "juro-legal-complete-corpus-20260904-dlq",
        "max_concurrency": 25
      }
    ]
  },
  "workflows": [
    {
      "binding": "EMPTY_VERSIONS_WORKFLOW",
      "name": "juro-legal-complete-corpus-empty-versions-20260904",
      "class_name": "CompleteCorpusEmptyVersionsWorkflow"
    },
    {
      "binding": "MATERIALIZATION_WORKFLOW",
      "name": "juro-legal-complete-corpus-20260904",
      "class_name": "CompleteCorpusMaterializationWorkflow"
    },
    {
      "binding": "MANIFEST_WORKFLOW",
      "name": "juro-legal-complete-corpus-manifest-20260904",
      "class_name": "CompleteCorpusManifestLaneWorkflow"
    },
    {
      "binding": "RECONSTRUCTION_WORKFLOW",
      "name": "juro-legal-complete-corpus-reconstruction-20260904",
      "class_name": "CompleteCorpusReconstructionLaneWorkflow"
    },
    {
      "binding": "FINALIZE_WORKFLOW",
      "name": "juro-legal-complete-corpus-finalize-20260904",
      "class_name": "CompleteCorpusFinalizeWorkflow"
    },
    {
      "binding": "QUALIFY_WORKFLOW",
      "name": "juro-legal-complete-corpus-qualify-20260904",
      "class_name": "CompleteCorpusQualifyWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  }
}
