{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-legal-search-build-proxy-local",
  "main": "./worker/local-legal-search-build-proxy.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "LEGAL_CORPUS_BUILD_SERVICE",
      "service": "juro-legal-corpus-staging",
      "remote": true
    }
  ]
}
